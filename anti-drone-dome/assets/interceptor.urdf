<?xml version="1.0"?>
<robot name="cuas_interceptor">
  <material name="body"><color rgba="0.16 0.32 0.52 1"/></material>
  <material name="edge"><color rgba="0.55 0.75 0.92 1"/></material>
  <link name="base_link">
    <inertial>
      <mass value="0.83"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.045" iyz="0" izz="0.050"/>
    </inertial>
    <visual>
      <origin rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.13" length="1.55"/></geometry>
      <material name="body"/>
    </visual>
    <collision><geometry><box size="1.55 0.35 0.30"/></geometry></collision>
  </link>
  <link name="nose">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="0.90 0 0" rpy="0 1.5708 0"/>
      <geometry><sphere radius="0.13"/></geometry>
      <material name="edge"/>
    </visual>
  </link>
  <joint name="nose_joint" type="fixed"><parent link="base_link"/><child link="nose"/></joint>
  <link name="left_fin">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.35 0.34 0"/>
      <geometry><box size="0.58 0.72 0.06"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="left_fin_joint" type="fixed"><parent link="base_link"/><child link="left_fin"/></joint>
  <link name="right_fin">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.35 -0.34 0"/>
      <geometry><box size="0.58 0.72 0.06"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="right_fin_joint" type="fixed"><parent link="base_link"/><child link="right_fin"/></joint>
  <link name="upper_fin">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.56 0 0.25"/>
      <geometry><box size="0.44 0.06 0.48"/></geometry>
      <material name="edge"/>
    </visual>
  </link>
  <joint name="upper_fin_joint" type="fixed"><parent link="base_link"/><child link="upper_fin"/></joint>
  <link name="lower_fin">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.56 0 -0.25"/>
      <geometry><box size="0.44 0.06 0.48"/></geometry>
      <material name="edge"/>
    </visual>
  </link>
  <joint name="lower_fin_joint" type="fixed"><parent link="base_link"/><child link="lower_fin"/></joint>
</robot>
