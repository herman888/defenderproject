<?xml version="1.0"?>
<robot name="shahed_136">
  <material name="airframe"><color rgba="0.34 0.36 0.31 1"/></material>
  <material name="dark"><color rgba="0.08 0.09 0.08 1"/></material>
  <link name="fuselage">
    <inertial>
      <mass value="1.4"/>
      <inertia ixx="0.28" ixy="0" ixz="0" iyy="0.55" iyz="0" izz="0.72"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.18" length="3.1"/></geometry>
      <material name="airframe"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="3.1 0.42 0.34"/></geometry>
    </collision>
  </link>
  <link name="nose">
