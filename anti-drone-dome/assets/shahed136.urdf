      <material name="airframe"/>
    </visual>
  </link>
  <joint name="left_wing_joint" type="fixed">
    <parent link="fuselage"/><child link="left_wing"/>
  </joint>
  <link name="right_wing">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.15 -0.82 0" rpy="0 0 0.24"/>
      <geometry><box size="1.95 1.65 0.08"/></geometry>
      <material name="airframe"/>
    </visual>
  </link>
  <joint name="right_wing_joint" type="fixed">
    <parent link="fuselage"/><child link="right_wing"/>
  </joint>
  <link name="tail_fin">
