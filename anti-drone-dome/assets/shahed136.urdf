    <visual>
      <origin xyz="1.72 0 0" rpy="0 1.5708 0"/>
      <geometry><sphere radius="0.18"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="nose_joint" type="fixed">
    <parent link="fuselage"/><child link="nose"/>
  </joint>
  <link name="left_wing">
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
    <visual>
      <origin xyz="-0.15 0.82 0" rpy="0 0 -0.24"/>
