# Fury F4 OSD — switch to this profile for the other drone.
BF_BOARD_NAME="Fury F4 OSD"
BF_TARGET="FURYF4OSD"
BF_RELEASE="2025.12.4"
BF_MOTOR_PROTOCOLS='["DSHOT"]'
BF_RADIO_PROTOCOLS='["SPEKTRUM"]'
BF_BUILD_OPTIONS='["CORE_ONLY"]'

PY="${PY:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)/gym-pybullet-drones/.venv/bin/python3}"
DFU="${DFU:-$(command -v dfu-util || echo /opt/homebrew/bin/dfu-util)}"
HEX="/tmp/bf_${BF_TARGET}_${BF_RELEASE}.hex"
