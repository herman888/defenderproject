{
  "schema": "aegis.hardware-profile.v1",
  "profile_id": "larp-betaflight-readonly-v1",
  "label": "LARP Betaflight bench (read-only)",
  "mode": "hardware_readonly",
  "autopilot": {
    "protocol": "msp",
    "firmware": "Betaflight 2025.12.4",
    "endpoint": null,
    "supported_targets": ["OMNIBUSF4", "OMNIBUSF4SD", "FURYF4OSD"]
  },
  "vehicle": {
    "name": "Lab quadrotor - measurements required",
    "mass_kg": 1.5,
    "max_speed_mps": 25.0,
    "max_accel_mps2": 40.0,
    "battery_capacity_wh": 50.0
  },
  "sensors": [
    {"name": "InnoMaker U20CAM", "protocol": "usb-uvc", "calibration_required": true},
    {"name": "flight-controller IMU", "protocol": "msp", "calibration_required": true}
  ],
  "links": [
    {"name": "Betaflight USB telemetry", "protocol": "msp", "rate_hz": 10.0}
  ],
  "safety": {
    "actuation_enabled": false,
    "requires_explicit_arm_ack": true,
    "requires_props_removed_ack": true,
    "approved_test_site_required": true
  },
  "validation_gates": {
    "minimum_intercept_rate": 0.95,
    "maximum_duration_p95_s": 30.0,
    "maximum_energy_p95": 6.0,
    "maximum_action_saturation_fraction": 0.25,
    "maximum_trajectory_rmse_m": 5.0,
    "maximum_timing_offset_s": 0.1
  }
}
