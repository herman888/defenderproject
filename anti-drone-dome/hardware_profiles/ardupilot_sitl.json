    "max_speed_mps": 70.0,
    "max_accel_mps2": 166.77,
    "battery_capacity_wh": 105.0
  },
  "sensors": [
    {"name": "SITL state estimator", "protocol": "mavlink", "calibration_required": false}
  ],
  "links": [
