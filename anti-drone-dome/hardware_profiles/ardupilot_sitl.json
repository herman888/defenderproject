{
  "schema": "aegis.hardware-profile.v1",
  "profile_id": "ardupilot-sitl-v1",
  "label": "ArduPilot SITL over MAVLink",
  "mode": "sitl",
  "autopilot": {
    "protocol": "mavlink",
    "firmware": "ArduCopter SITL",
    "endpoint": "udp://127.0.0.1:14560"
  },
  "vehicle": {
    "name": "ArduCopter virtual interceptor",
